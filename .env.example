# ─────────────────────────────────────────────
# Sarkari Naukri — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Your Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Vercel Blob — required for jobs to persist across refreshes / users.
# On Vercel, connect a Blob store (Storage tab) and this is added automatically.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
# Optional: folder inside the store for app files (jobs.json + uploaded PDFs)
BLOB_FOLDER=jobs

# Admin login — protects the write endpoints (upload / add / save jobs).
# Change these for production. ADMIN_SESSION_SECRET signs session tokens;
# if unset it is derived from ADMIN_PASSWORD.
ADMIN_USERNAME=ramesh
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=use-a-long-random-string

# Optional: set to "production" in Vercel dashboard
NODE_ENV=development
